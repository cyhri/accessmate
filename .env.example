# ==============================================================================
# ACCESSMATE — Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development.
# Do NOT commit production credentials or API secrets to version control.

# Application Environment
NODE_ENV=development
NEXT_PUBLIC_APP_NAME="ACCESSMATE"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# OpenRouteService / HeiGIT API Integration (Phase 5)
# Obtain a free token from https://openrouteservice.org/dev/#/signup
ORS_API_KEY="your-openrouteservice-api-key"
NEXT_PUBLIC_ORS_API_KEY="your-openrouteservice-api-key"

# ==============================================================================
# Supabase Primary Backend Configuration
# ==============================================================================
# Project URL (Find in Supabase Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"

# Public Browser-Safe Publishable / Anon Key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-or-anon-key"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-publishable-or-anon-key"

# Server-Only Secret Service Role Key (NEVER expose in browser or client code!)
# Used for server-side role management and administrative operations
SUPABASE_SECRET_KEY="your-supabase-service-role-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Direct PostgreSQL Connection URL (Used for applying migrations)
DATABASE_URL="postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres"
